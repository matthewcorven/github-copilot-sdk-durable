<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Durable.EfCore</RootNamespace>
    <AssemblyName>Durable.EfCore</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- The SQLite provider is the migration baseline. The model itself is provider-neutral;
         the server providers live in their own assemblies (Durable.EfCore.SqlServer,
         Durable.EfCore.PostgreSql, Durable.EfCore.MySql) so each carries its own migration. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- The provider implements Copilot.Durable's IDurableStoreProvider seam. -->
    <ProjectReference Include="..\Copilot.Durable.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Durable.EfCore.Tests" />
  </ItemGroup>

</Project>
