<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BandCDurable</AssemblyName>
    <RootNamespace>BandC.Durable</RootNamespace>
    <NoWarn>GHCP001;$(NoWarn)</NoWarn>
  </PropertyGroup>

  <!-- The durable layer is consumed as the project reference, never copied: this scenario exists to
       show what lib/Durable.cs can express, so a private copy would defeat it. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\lib\Copilot.Durable.csproj" />
  </ItemGroup>

  <!-- The evidence folder holds readers and a standalone reproduction, not part of the application. -->
  <ItemGroup>
    <Compile Remove="evidence\**" />
    <None Remove="evidence\**" />
  </ItemGroup>

  <!-- The baseline's fixture is the same snapshot, read from one place: a second copy would drift. -->
  <ItemGroup>
    <None Include="..\baseline\fixture\pull-requests.json" Link="fixture\pull-requests.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
