# The Foundry Local AAR is fetched, never committed: its license forbids redistribution.
# See DECISION-bridge.md §5 and fetch-aar.sh.
libs/
*.aar

# Any MAUI/Android head added here follows the other bands.
bin/
obj/

# Gradle build output for the Kotlin facade. The wrapper (gradlew, gradle/wrapper) is
# committed so the build is reproducible at the pinned version; the caches are not.
bridge/build/
bridge/.gradle/
bridge/local.properties
.gradle/
.kotlin/

# Scratch: drive scripts, pull copies and intermediate screenshots from a demonstration run. The
# evidence that matters is copied into evidence/ before a run is finished; this is the working set.
.scratch/
