<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BandEMobile.MainPage"
             Title="Band E - Foundry Local">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Foundry Local bridge" FontSize="22" FontAttributes="Bold" />

            <Label x:Name="TransportLabel" Text="transport: (not checked)" FontSize="13" />
            <Label x:Name="AvailabilityLabel" Text="companion: (not checked)" FontSize="13" />

            <BoxView HeightRequest="1" Color="Gray" Margin="0,6" />

            <Label Text="Conversation" FontAttributes="Bold" FontSize="15" />
            <Label x:Name="TranscriptLabel" Text="(no turns yet)" FontSize="13" />

            <Button x:Name="SendButton" Text="Send turn" Clicked="OnSendClicked" />

            <Label x:Name="ResultLabel" FontSize="13" FontAttributes="Italic" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
