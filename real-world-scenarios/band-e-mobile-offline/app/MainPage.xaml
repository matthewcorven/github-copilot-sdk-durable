<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BandEMobile.MainPage"
             Title="Band E — offline">

    <!--
        Sized for the demonstration, not for general use: the emulator's window is 320x640dp at
        density 1. Everything that has to be readable in a screenshot is 11-13pt and the whole page
        scrolls. The order — document, then conversation, then the controls — is the order the
        evidence reads in: "document intact" and "four turns" are the two facts to check.
    -->
    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="6">

            <Label x:Name="HeaderLabel" FontSize="14" FontAttributes="Bold"
                   Text="Band E — on-device Durable + on-device model" />

            <Label x:Name="StatusLabel" FontSize="10" LineBreakMode="WordWrap" Text="starting…" />

            <BoxView HeightRequest="1" Color="Gray" />

            <Label FontSize="11" FontAttributes="Bold" Text="DOCUMENT (durable, agent-edited)" />
            <Label x:Name="DocumentRevisionLabel" FontSize="10" Text="revision —" />
            <Label x:Name="DocumentTitleLabel" FontSize="12" FontAttributes="Bold" Text="—" />
            <Label x:Name="DocumentBodyLabel" FontSize="11" LineBreakMode="WordWrap" Text="—" />

            <BoxView HeightRequest="1" Color="Gray" />

            <Label FontSize="11" FontAttributes="Bold" Text="CONVERSATION (durable transcript)" />
            <VerticalStackLayout x:Name="TranscriptList" Spacing="4" />
            <Label x:Name="StreamingLabel" FontSize="11" FontAttributes="Italic" Text="" />

            <BoxView HeightRequest="1" Color="Gray" />

            <Entry x:Name="InputEntry" FontSize="11" Placeholder="type a turn, or tap the next scripted turn" />

            <HorizontalStackLayout Spacing="4">
                <Button x:Name="SendButton" Text="Send turn" FontSize="11" Padding="8,2" Clicked="OnSendClicked" />
                <Button x:Name="ScriptButton" Text="Next scripted turn" FontSize="11" Padding="8,2" Clicked="OnScriptClicked" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="4">
                <Button x:Name="PrepareButton" Text="Prepare model" FontSize="11" Padding="8,2" Clicked="OnPrepareClicked" />
                <Button x:Name="CatalogButton" Text="Catalog" FontSize="11" Padding="8,2" Clicked="OnCatalogClicked" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="4">
                <Button x:Name="CaptureButton" Text="Measure" FontSize="11" Padding="8,2" Clicked="OnCaptureClicked" />
                <Button x:Name="ExportButton" Text="Export" FontSize="11" Padding="8,2" Clicked="OnExportClicked" />
                <Button x:Name="ResetButton" Text="Reset" FontSize="11" Padding="8,2" Clicked="OnResetClicked" />
            </HorizontalStackLayout>

            <Label x:Name="ResultLabel" FontSize="10" LineBreakMode="WordWrap" Text="" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
