<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ReplayRuntime</AssemblyName>
    <RootNamespace>ReplayRuntime</RootNamespace>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The runtime is launched as a child process; a single-file publish keeps the
         launch path stable and avoids a runtimeconfig probe on the SDK side. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReplayRuntime.Tests" />
  </ItemGroup>

  <!-- The default fixture path is fixtures/basic.json next to the executable, so the
       checked-in fixtures must land beside the binary. -->
  <ItemGroup>
    <None Include="fixtures/**/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
